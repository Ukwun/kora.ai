# Session Management
SESSION_SECRET=your-secure-random-session-secret-here

# Node Environment
NODE_ENV=production

# Firebase Admin (Firestore-backed business memory)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-admin-service-account@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-with-private-key\\n-----END PRIVATE KEY-----\\n"
# Alternatively provide the service account JSON as one escaped JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Production database (required in production; use a managed PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@host:5432/kora?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# API Configuration
API_BASE_URL=https://your-domain.com

# OAuth (Optional - configure when ready)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Email Service (Optional - for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# AI / LLM (Optional - enables smarter AI recommendations)
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-5

# Payments (required before accepting live payment webhooks)
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Analytics (Optional)
POSTHOG_API_KEY=your-posthog-key
SENTRY_DSN=your-sentry-dsn

# Feature Flags
ENABLE_OAUTH=false
ENABLE_EMAIL_VERIFICATION=false
ENABLE_ANALYTICS=false
